generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES_USER
}

enum DataSourceType {
  COMPANY_DATA
  IMPORTED_DATA
  AI_ESTIMATE
  EXTERNAL_DATA
  USER_ASSUMPTION
}

enum SalesRecordSource {
  MANUAL
  CSV_IMPORT
  FMS_SYNC
}

enum ProspectStatus {
  NEW
  CONTACTED
  RESPONDED
  QUALIFIED
  QUOTATION
  NEGOTIATION
  WON
  LOST
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ProspectSource {
  MANUAL
}

enum LeadClassification {
  HOT
  WARM
  COLD
}

enum ScoreMethod {
  AI
  RULE_BASED
}

enum FeedbackRating {
  TOO_HIGH
  ACCURATE
  TOO_LOW
}

enum AdPlatform {
  META
  GOOGLE
}

enum AdConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum AdCampaignSource {
  MANUAL
  META_SYNC
  GOOGLE_SYNC
}

enum DistributorType {
  DISTRIBUTOR
  DEALER
}

enum DistributorStatus {
  PROSPECTIVE
  ACTIVE
  INACTIVE
}

enum OptimizationRecommendationType {
  SCHEDULE_FOLLOW_UP
  AT_RISK_FOLLOW_UP
  PAUSE_UNDERPERFORMING_CAMPAIGN
  DISTRIBUTOR_EXPANSION_ADVISORY
}

enum OptimizationRecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  EXECUTION_FAILED
}

enum OptimizationTargetType {
  ACCOUNT
  PROSPECT
  AD_CAMPAIGN
  STATE
}

model Company {
  id                  String   @id @default(cuid())
  name                String
  industry            String
  description         String?
  website             String?
  contactEmail        String?
  contactPhone        String?
  headquartersStateId String?
  headquartersState   State?   @relation("HQState", fields: [headquartersStateId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users                User[]
  products             Product[]
  salesRecords         SalesRecord[]
  importBatches        SalesImportBatch[]
  operatingStates      CompanyOperatingState[]
  targetStates         CompanyTargetState[]
  accounts             Account[]
  prospects            Prospect[]
  leadScores           LeadScore[]
  followUps            FollowUp[]
  adAccountConnections AdAccountConnection[]
  adCampaigns          AdCampaign[]
  distributors         Distributor[]
  optimizationRecommendations OptimizationRecommendation[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SALES_USER)
  isActive     Boolean  @default(true)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesRecords           SalesRecord[]         @relation("Salesperson")
  auditLogs              AuditLog[]
  assignedProspects      Prospect[]
  createdProspects       Prospect[]            @relation("ProspectCreatedBy")
  leadScoresCreated      LeadScore[]
  leadScoreFeedback      LeadScoreFeedback[]
  assignedFollowUps      FollowUp[]            @relation("FollowUpAssignedUser")
  createdFollowUps       FollowUp[]            @relation("FollowUpCreatedBy")
  adConnectionsConnected AdAccountConnection[] @relation("AdConnectionConnectedBy")
  adCampaignsCreated     AdCampaign[]          @relation("AdCampaignCreatedBy")
  distributorsAssigned   Distributor[]         @relation("DistributorAssignedUser")
  distributorsCreated    Distributor[]         @relation("DistributorCreatedBy")
  optimizationRecommendationsReviewed OptimizationRecommendation[] @relation("OptimizationReviewedBy")

  @@index([companyId])
}

model State {
  id     String  @id @default(cuid())
  name   String  @unique
  code   String  @unique
  region String?

  cities                 City[]
  companiesHQ            Company[]               @relation("HQState")
  operatingCompanies     CompanyOperatingState[]
  targetCompanies        CompanyTargetState[]
  salesRecords           SalesRecord[]
  accounts               Account[]
  prospects              Prospect[]
  distributorTerritories DistributorTerritory[]
}

model City {
  id      String @id @default(cuid())
  name    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id])
  tier    Int?

  salesRecords SalesRecord[]
  accounts     Account[]
  prospects    Prospect[]

  @@unique([name, stateId])
  @@index([stateId])
}

model Industry {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  products     ProductTargetIndustry[]
  salesRecords SalesRecord[]
  accounts     Account[]
  prospects    Prospect[]
}

model BusinessType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  products  ProductTargetBusinessType[]
  prospects Prospect[]
}

model CompanyOperatingState {
  companyId String
  stateId   String
  company   Company @relation(fields: [companyId], references: [id])
  state     State   @relation(fields: [stateId], references: [id])

  @@id([companyId, stateId])
}

model CompanyTargetState {
  companyId String
  stateId   String
  notes     String?
  company   Company @relation(fields: [companyId], references: [id])
  state     State   @relation(fields: [stateId], references: [id])

  @@id([companyId, stateId])
}

model Product {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  sku          String
  category     String?
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  minOrderQty  Int      @default(1)
  availableQty Int      @default(0)
  keywords     String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  targetIndustries    ProductTargetIndustry[]
  targetBusinessTypes ProductTargetBusinessType[]
  salesRecords        SalesRecord[]
  prospectInterests   ProspectProductInterest[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model ProductTargetIndustry {
  productId  String
  industryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  industry   Industry @relation(fields: [industryId], references: [id])

  @@id([productId, industryId])
}

model ProductTargetBusinessType {
  productId      String
  businessTypeId String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id])

  @@id([productId, businessTypeId])
}

model SalesRecord {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id])
  date          DateTime
  productId     String?
  product       Product?          @relation(fields: [productId], references: [id])
  customerName  String
  stateId       String?
  state         State?            @relation(fields: [stateId], references: [id])
  cityId        String?
  city          City?             @relation(fields: [cityId], references: [id])
  industryId    String?
  industry      Industry?         @relation(fields: [industryId], references: [id])
  quantity      Int
  orderValue    Decimal           @db.Decimal(14, 2)
  salespersonId String?
  salesperson   User?             @relation("Salesperson", fields: [salespersonId], references: [id])
  isNewCustomer Boolean           @default(false)
  source        SalesRecordSource @default(MANUAL)
  importBatchId String?
  importBatch   SalesImportBatch? @relation(fields: [importBatchId], references: [id])
  accountId     String?
  account       Account?          @relation(fields: [accountId], references: [id])
  distributorId String?
  distributor   Distributor?      @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  // Phase 2A (FMS sync hardening) — both additive, both null for every
  // existing MANUAL/CSV_IMPORT record and unused by any of them.
  // externalRef: a deterministic identity from the originating external
  // source (for FMS_SYNC: "<Bill No.>|<टाइमस्टैम्प>"), enforced unique per
  // (companyId, source) below so the DB itself — not just application
  // logic — rejects a duplicate re-sync of the same source order. Multiple
  // NULLs (every MANUAL/CSV_IMPORT row) never collide under this
  // constraint — that's standard Postgres unique-index semantics.
  // metadata: the original source row's fields that have no dedicated
  // column here (raw "Product and Qty" text, Bill No., timestamp, Order
  // Taken, Dispatched By, PDC Cheque Date, Bill Amount) — preserved
  // verbatim, never interpreted, never read by any existing service.
  externalRef   String?
  metadata      Json?
  // Set when the source bill was cancelled (FMS: Customer Name "CANCELLED"
  // with a blank Bill Amount). The record is kept for history; sales totals
  // and analytics exclude it (`cancelledAt: null`).
  cancelledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([companyId, source, externalRef])
  @@index([companyId, date])
  @@index([stateId])
  @@index([industryId])
  @@index([productId])
  @@index([accountId])
  @@index([distributorId])
}

model SalesImportBatch {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  fileName     String
  uploadedById String?
  totalRows    Int
  successRows  Int      @default(0)
  failedRows   Int      @default(0)
  errors       Json?
  status       String
  createdAt    DateTime @default(now())

  records SalesRecord[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}

model Account {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  name           String
  normalizedName String // lowercased/trimmed, used for dedup matching against customerName
  stateId        String?
  state          State?    @relation(fields: [stateId], references: [id])
  cityId         String?
  city           City?     @relation(fields: [cityId], references: [id])
  industryId     String?
  industry       Industry? @relation(fields: [industryId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  salesRecords SalesRecord[]
  scores       LeadScore[]
  followUps    FollowUp[]

  @@unique([companyId, normalizedName])
  @@index([companyId])
}

model Prospect {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  businessName   String
  industryId     String?
  industry       Industry?      @relation(fields: [industryId], references: [id])
  businessTypeId String?
  businessType   BusinessType?  @relation(fields: [businessTypeId], references: [id])
  stateId        String?
  state          State?         @relation(fields: [stateId], references: [id])
  cityId         String?
  city           City?          @relation(fields: [cityId], references: [id])
  website        String?
  contactEmail   String?
  contactPhone   String?
  source         ProspectSource @default(MANUAL)
  status         ProspectStatus @default(NEW)
  assignedUserId String?
  assignedUser   User?          @relation(fields: [assignedUserId], references: [id])
  createdById    String?
  createdBy      User?          @relation("ProspectCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  campaignId     String?
  campaign       AdCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  productsOfInterest ProspectProductInterest[]
  scores             LeadScore[]
  followUps          FollowUp[]

  @@index([companyId])
}

model ProspectProductInterest {
  prospectId String
  productId  String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@id([prospectId, productId])
}

model LeadScore {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  accountId         String?
  account           Account?           @relation(fields: [accountId], references: [id])
  prospectId        String?
  prospect          Prospect?          @relation(fields: [prospectId], references: [id])
  score             Int // 0-100
  classification    LeadClassification // derived deterministically from score, not trusted from the AI
  method            ScoreMethod // AI or RULE_BASED (fallback)
  reasons           Json // [{ factor, signal: positive|negative|neutral, detail }]
  recommendedAction Json // { action, rationale }
  inputFeatures     Json // real computed numbers fed to the model — recencyDays, orderCount, totalOrderValue, averageOrderValue, productFitScore, stateAlignment
  provider          String // "openai" | "anthropic" | "mock"
  modelName         String?
  promptVersion     String
  isLatest          Boolean            @default(true)
  createdById       String?
  createdBy         User?              @relation(fields: [createdById], references: [id])
  createdAt         DateTime           @default(now())

  feedback LeadScoreFeedback[]

  @@index([companyId, accountId, isLatest])
  @@index([companyId, prospectId, isLatest])
}

model LeadScoreFeedback {
  id          String         @id @default(cuid())
  leadScoreId String
  leadScore   LeadScore      @relation(fields: [leadScoreId], references: [id])
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  rating      FeedbackRating
  comment     String?
  createdAt   DateTime       @default(now())

  @@index([leadScoreId])
}

model FollowUp {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  accountId       String?
  account         Account?       @relation(fields: [accountId], references: [id])
  prospectId      String?
  prospect        Prospect?      @relation(fields: [prospectId], references: [id])
  dueDate         DateTime
  notes           String?
  status          FollowUpStatus @default(PENDING)
  completedAt     DateTime?
  completionNotes String?
  assignedUserId  String?
  assignedUser    User?          @relation("FollowUpAssignedUser", fields: [assignedUserId], references: [id])
  createdById     String?
  createdBy       User?          @relation("FollowUpCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId, dueDate])
  @@index([accountId])
  @@index([prospectId])
}

model AdAccountConnection {
  id                    String             @id @default(cuid())
  companyId             String
  company               Company            @relation(fields: [companyId], references: [id])
  platform              AdPlatform
  externalAccountId     String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  status                AdConnectionStatus @default(DISCONNECTED)
  lastSyncedAt          DateTime?
  connectedByUserId     String?
  connectedBy           User?              @relation("AdConnectionConnectedBy", fields: [connectedByUserId], references: [id])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([companyId, platform])
}

model AdCampaign {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  platform           AdPlatform
  source             AdCampaignSource @default(MANUAL)
  externalCampaignId String?
  name               String
  startDate          DateTime
  endDate            DateTime?
  isActive           Boolean          @default(true)
  createdById        String?
  createdBy          User?            @relation("AdCampaignCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  spendRecords AdSpendRecord[]
  prospects    Prospect[]

  @@index([companyId])
}

model AdSpendRecord {
  id          String           @id @default(cuid())
  campaignId  String
  campaign    AdCampaign       @relation(fields: [campaignId], references: [id])
  date        DateTime
  amount      Decimal          @db.Decimal(12, 2)
  impressions Int?
  clicks      Int?
  source      AdCampaignSource @default(MANUAL)
  createdAt   DateTime         @default(now())

  @@index([campaignId, date])
}

model Distributor {
  id             String            @id @default(cuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  name           String
  type           DistributorType
  status         DistributorStatus @default(PROSPECTIVE)
  contactEmail   String?
  contactPhone   String?
  assignedUserId String?
  assignedUser   User?             @relation("DistributorAssignedUser", fields: [assignedUserId], references: [id])
  createdById    String?
  createdBy      User?             @relation("DistributorCreatedBy", fields: [createdById], references: [id])
  onboardedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  territories  DistributorTerritory[]
  salesRecords SalesRecord[]

  @@index([companyId])
}

model DistributorTerritory {
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  stateId       String
  state         State       @relation(fields: [stateId], references: [id])

  @@id([distributorId, stateId])
}

model OptimizationRecommendation {
  id               String                            @id @default(cuid())
  companyId        String
  company          Company                           @relation(fields: [companyId], references: [id])
  type             OptimizationRecommendationType
  status           OptimizationRecommendationStatus  @default(PENDING)
  targetType       OptimizationTargetType
  targetId         String
  targetLabel      String
  actionType       String
  actionParams     Json
  evidence         Json
  narrative        String?
  narrativeMethod  ScoreMethod
  reviewedByUserId String?
  reviewedBy       User?    @relation("OptimizationReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  executedAt       DateTime?
  executionResult  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, type, targetType, targetId])
}
