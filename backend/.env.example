DATABASE_URL=postgresql://sales_engine:sales_engine_dev_password@localhost:5432/ai_sales_expansion_engine
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LEAD_RESCORE_COOLDOWN_HOURS=24
META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
FMS_API_URL=
FMS_PAGED_API_URL=
# Automatic FMS sync of the "FMS Response" sheet into the database (off unless "true")
FMS_AUTO_SYNC_ENABLED=false
FMS_AUTO_SYNC_INTERVAL_MINUTES=5
# Optional while there is only one company
FMS_AUTO_SYNC_COMPANY_ID=
# Read-only Google Sheets API access (scripts/sheet-catalog.ts). Service account
# key file path (or its JSON); share the spreadsheet with its email as Viewer.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_KEY=
# Negative Bill Amount rows are adjustments of the bill with the same Bill No. (net amount)
FMS_NEGATIVE_ADJUSTMENTS_ENABLED=false
